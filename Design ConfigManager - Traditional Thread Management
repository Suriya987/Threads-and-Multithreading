  using System;
using System.Collections.Generic;
using System.Threading;

namespace ConfigManager;

public class ConfigFile
{
    private readonly int _versionId;
    private readonly Dictionary<string, string> _properties;

    public ConfigFile(int versionId, Dictionary<string, string> prop)
    {
        if (prop == null || prop.Count == 0)
            throw new ArgumentException("Properties cannot be null or empty.");

        _versionId = versionId;
        _properties = new Dictionary<string, string>(prop);
    }

    public string GetProp(string key) =>
        _properties.TryGetValue(key, out var val) ? val : null;

    public int GetVersionId() => _versionId;
}

public sealed class ConfigurationManager
{
    // ── Singleton ──────────────────────────────────────────────
    private static volatile ConfigurationManager _instance;
    private static readonly object _instanceLock = new object();

    public static ConfigurationManager GetConfigManagerInstance()
    {
        if (_instance == null)
        {
            lock (_instanceLock)
            {
                if (_instance == null)
                    _instance = new ConfigurationManager();
            }
        }
        return _instance;
    }

    // ── State ──────────────────────────────────────────────────
    private volatile ConfigFile _currentConfigFile;
    private readonly List<ConfigFile> _configHistory = new List<ConfigFile>();
    private readonly object _writeLock = new object();

    private ConfigurationManager() { }

    // ── Write ──────────────────────────────────────────────────
    public void AddConfigFile(ConfigFile configFile)
    {
        if (configFile == null)
            throw new ArgumentNullException(nameof(configFile));

        lock (_writeLock)
        {
            _configHistory.Add(configFile);
            _currentConfigFile = configFile;

            if (_configHistory.Count > 4)
                _configHistory.RemoveRange(0, 3);

            Console.WriteLine(
                $"[WRITE] Thread={Thread.CurrentThread.Name,-10} " +
                $"pushed Version={configFile.GetVersionId()} " +
                $"| IsFeatureAdded={configFile.GetProp("IsFeatureAdded")} " +
                $"| Time={DateTime.Now:HH:mm:ss.fff}");

            // wake up all waiting reader threads
            Monitor.PulseAll(_writeLock);
        }
    }

    // ── Read ───────────────────────────────────────────────────
    public ConfigFile GetCurrentConfigFile()
    {
        if (_currentConfigFile == null)
            throw new InvalidOperationException(
                "ConfigurationManager not initialised. Call AddConfigFile first.");
        return _currentConfigFile;
    }
}

class ClassA
{
    private readonly ConfigurationManager _configManager
        = ConfigurationManager.GetConfigManagerInstance();

    public void Execute()
    {
        var stop = DateTime.Now.AddSeconds(5);
        while (DateTime.Now < stop)
        {
            ConfigFile configFile = _configManager.GetCurrentConfigFile();
            Console.WriteLine(
                $"[READ ] Thread={Thread.CurrentThread.Name,-10} " +
                $"Version={configFile.GetVersionId()} " +
                $"| IsFeatureAdded={configFile.GetProp("IsFeatureAdded")} " +
                $"| Time={DateTime.Now:HH:mm:ss.fff}");

            Thread.Sleep(500);
        }
        Console.WriteLine(
            $"[READ ] Thread={Thread.CurrentThread.Name,-10} finished.");
    }
}

