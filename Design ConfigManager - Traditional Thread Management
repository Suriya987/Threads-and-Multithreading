class User
{
    static void Main(string[] args)
    {
        ConfigurationManager manager
            = ConfigurationManager.GetConfigManagerInstance();

        manager.AddConfigFile(new ConfigFile(1, new Dictionary<string, string>{
        ["IsFeatured"] = "Enabled"
        }));

        // ── Create reader threads ──────────────────────────────
        ClassA readerA1 = new ClassA();
        ClassA readerA2 = new ClassA();
        ClassB readerB1 = new ClassB();

        Thread t1 = new Thread(readerA1.Execute);
        Thread t2 = new Thread(readerA2.Execute);
        Thread t3 = new Thread(readerB1.Execute);

        t1.Name = "Reader-1";
        t2.Name = "Reader-2";
        t3.Name = "Reader-3";

        // ── Create writer threads ──────────────────────────────
        Thread t4 = new Thread(Writer1);
        Thread t5 = new Thread(Writer2);

        t4.Name = "Writer-1";
        t5.Name = "Writer-2";

        // ── Start all threads ──────────────────────────────────
        t1.Start();
        t2.Start();
        t3.Start();
        t4.Start();
        t5.Start();

        // ── Wait for all threads to finish ─────────────────────
        t1.Join();
        t2.Join();
        t3.Join();
        t4.Join();
        t5.Join();

        Console.WriteLine("\nAll threads finished.");
        Console.ReadLine();
    }

    // ── Writer methods — each pushes one version ───────────────
    static void Writer1()
    {
        ConfigurationManager manager
            = ConfigurationManager.GetConfigManagerInstance();

        // seed initial config immediately
        manager.AddConfigFile(new ConfigFile(1, new Dictionary<string, string>
        {
            ["IsFeatureAdded"] = "Enabled"
        }));

        // wait 1 second then push version 2
        Thread.Sleep(1000);

        manager.AddConfigFile(new ConfigFile(2, new Dictionary<string, string>
        {
            ["IsFeatureAdded"] = "Disabled"
        }));

        Console.WriteLine($"[WRITE] Thread={Thread.CurrentThread.Name,-10} finished.");
    }

    static void Writer2()
    {
        ConfigurationManager manager
            = ConfigurationManager.GetConfigManagerInstance();

        // wait 3 seconds then push version 3
        Thread.Sleep(3000);

        manager.AddConfigFile(new ConfigFile(3, new Dictionary<string, string>
        {
            ["IsFeatureAdded"] = "Enabled"
        }));

        Console.WriteLine(
            $"[WRITE] Thread={Thread.CurrentThread.Name,-10} finished.");
    }
}
